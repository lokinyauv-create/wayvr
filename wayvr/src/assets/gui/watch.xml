<layout version="2">
  <vars>
    <var key="clock0_size" value="46" />
    <var key="clock0_date_size" value="16" />
    <var key="clock0_dow_size" value="16" />
    <var key="fps_size" value="24" />
    <var key="fps_repr_size" value="14" />
  </vars>

  <macro name="decorative_rect"
    padding="8" color="background"
    border="2" border_color="outline" round="8" />

  <macro name="button_style" padding="8" border="2" round="8" align_items="center" justify_content="center" />

  <template name="Device">
    <rectangle macro="decorative_rect" padding_top="4" padding_bottom="4" align_items="center" gap="8">
      <sprite width="32" height="32" src_builtin="${src}" color="on_background" />
      <label _source="battery" _device="${idx}" size="24" weight="bold" _low_color="danger" _normal_color="primary" _charging_color="tertiary" />
    </rectangle>
  </template>

  <template name="Hmd">
    <Device idx="${idx}" src="@/watch/hmd.svg" />
  </template>
  <template name="LeftHand">
    <Device idx="${idx}" src="@/watch/controller_l.svg" />
  </template>
  <template name="RightHand">
    <Device idx="${idx}" src="@/watch/controller_r.svg" />
  </template>
  <template name="Tracker">
    <Device idx="${idx}" src="@/watch/track.svg" />
  </template>

  <template name="Screen">
    <Button macro="button_style" id="overlay_${idx}" tooltip_str="${name}" _press="::OverlayToggle ${name}">
      <sprite width="38" height="38" src_builtin="@/edit/screen.svg" />
      <div position="absolute" margin_top="-7" margin_left="-1">
        <label text="${display}" size="18" weight="bold" parent_color="background" />
      </div>
    </Button>
  </template>

  <template name="Clock">
    <div gap="12" flex_direction="column" padding="4">
      <div flex_direction="column" >
        <label text="11:22 PM" _source="clock" _display="time" color="on_background" size="~clock0_size" weight="bold" align="center" />
        <div padding_left="2" gap="16" flex_direction="row" justify_content="center">
          <label text="Tue" _source="clock" _display="dow_short" color="on_background_variant" size="~clock0_dow_size" weight="bold" />
          <label text="22/2/2022" _source="clock" _display="date" color="on_background_variant" size="~clock0_date_size" weight="bold" />
        </div>
      </div>
      <!-- Frame rate of the running VR game (SteamVR only) -->
      <div flex_direction="column" align_items="center">
        <label text="90 FPS" _source="fps" _display="fps" size="~fps_size" weight="bold" align="center" />
        <label text="репр. 0%" _source="fps" _display="reprojection" size="~fps_repr_size" weight="bold" align="center" />
      </div>
    </div>
  </template>

  <template name="VerticalSeparator">
    <rectangle width="2" height="100%" color="outline" />
  </template>

  <elements>
    <!-- padding="32" is required there (to make room for tooltips) -->
    <div
      padding="32" interactable="0"
      flex_direction="column" gap="8">
      <!-- Top elements (device battery levels) -->
      <div id="devices_root" interactable="0" gap="6" width="100%" max_width="400" flex_direction="row" flex_wrap="wrap">
        <!-- Will populate tags at runtime -->
        <!-- These are examples for uidev -->
        <Hmd idx="0" />
        <LeftHand idx="1" />
        <RightHand idx="2" />
        <Tracker idx="3" />
      </div>

      <!-- All other elements inside the container -->
      <div flex_direction="column" gap="8" min_width="300">
        <rectangle macro="decorative_rect" flex_direction="row" gap="8" justify_content="space_evenly">
          <!-- Clock, date and frame rate -->
          <div id="clock_root">
            <Clock />
          </div>

          <!-- Keyboard and edit mode -->
          <div flex_direction="column" gap="8" justify_content="center">
            <Button id="btn_keyboard" macro="button_style" _press="::OverlayToggle kbd" tooltip="EDIT_MODE.KEYBOARD" tooltip_side="left">
              <sprite src_builtin="@/watch/keyboard.svg" width="40" height="40" />
            </Button>
            <Button id="btn_trackers" macro="button_style" _press="::OverlayToggle trackers" tooltip_str="Калібрування трекерів" tooltip_side="left">
              <sprite width="40" height="40" src="@/watch/track.svg" />
            </Button>
            <Button id="btn_edit_mode" macro="button_style" _press="::EditToggle" tooltip="WATCH.EDIT_MODE" tooltip_side="left">
              <sprite width="40" height="40" src="@/watch/edit.svg" />
            </Button>
          </div>
        </rectangle>

        <!-- Bottom buttons -->
        <div flex_direction="row" gap="8">
          <div gap="4">
            <Button id="btn_dashboard" macro="button_style" _press="::DashToggle" tooltip="WATCH.DASHBOARD" tooltip_side="top">
              <sprite width="40" height="40" src="@/watch/wayvr_dashboard_mono.svg" />
            </Button>
          </div>
          <VerticalSeparator />
          <!-- Screens only -->
          <div id="panels_root" gap="4">
            <!-- Will populate tags at runtime -->
            <!-- These are examples for uidev -->
            <Screen idx="0" display="H1" name="HDMI-A-1" />
            <Screen idx="1" display="D2" name="DP-2"/>
          </div>
          <VerticalSeparator />
          <!-- Bring screens and keyboard back in front of the user -->
          <div gap="4">
            <Button id="btn_reset_layout" macro="button_style" _press="::ResetLayout" tooltip_str="Скинути монітори й клавіатуру" tooltip_side="top">
              <sprite width="40" height="40" src="@/watch/reset.svg" />
            </Button>
          </div>
        </div>
      </div>
    </div>
  </elements>
</layout>
